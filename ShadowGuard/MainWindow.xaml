<Window x:Class="ShadowGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShadowGuard"
        Icon="pack://application:,,,/Assets/shadowguard.ico"
        Width="1480"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Background="#F4EFE7">
  <Window.Resources>
    <SolidColorBrush x:Key="SlateBrush" Color="#183243" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D8682D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF0E7" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFCF8" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E3D8CB" />

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource SlateBrush}" />
      <Setter Property="Background" Value="#F2E7D9" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="#D7CABC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="AlternatingRowBackground" Value="#FAF4EE" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E3D8CB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ColumnHeaderStyle">
        <Setter.Value>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2E8DC" />
            <Setter Property="Foreground" Value="{StaticResource SlateBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E3D8CB" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="24" CornerRadius="24" Background="#FFF8F2" BorderBrush="#E7D7C7" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.6*" />
            <ColumnDefinition Width="1.2*" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="ShadowGuard" FontFamily="Bahnschrift" FontSize="34" FontWeight="Bold" Foreground="{StaticResource SlateBrush}" />
            <TextBlock Margin="0,10,0,0" Foreground="#355061" FontSize="15" TextWrapping="Wrap"
                       Text="供应链安全桌面防火墙，围绕依赖检测、SBOM 风险评估与 CI/CD 安全闸门打造一个本地可操作的安全工作台。" />
            <WrapPanel Margin="0,16,0,0">
              <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="14" Padding="12,6" Margin="0,0,10,0">
                <TextBlock Text="恶意依赖检测" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
              </Border>
              <Border Background="#EEF4F6" CornerRadius="14" Padding="12,6" Margin="0,0,10,0">
                <TextBlock Text="SBOM 与风险评估" Foreground="{StaticResource SlateBrush}" FontWeight="SemiBold" />
              </Border>
              <Border Background="#F1EEE8" CornerRadius="14" Padding="12,6">
                <TextBlock Text="CI/CD 安全闸门" Foreground="#7A5A3B" FontWeight="SemiBold" />
              </Border>
            </WrapPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock Text="当前状态" FontSize="12" Foreground="#6D7F8A" />
            <TextBlock Margin="0,4,0,18" Text="{Binding StatusMessage}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" TextWrapping="Wrap" Width="320" />
            <WrapPanel HorizontalAlignment="Right">
              <Button Content="开始扫描" Click="Scan_Click" />
              <Button Content="导出报告" Click="ExportReport_Click" Style="{StaticResource GhostButtonStyle}" />
              <Button Content="导出 SBOM" Click="ExportSbom_Click" Style="{StaticResource GhostButtonStyle}" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.35*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0" Background="Transparent" BorderThickness="0">
          <TabItem Header="依赖防火墙">
            <Grid Margin="0,14,16,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="目标项目" FontSize="13" Foreground="#6C7C86" />
                    <TextBox Margin="0,8,0,0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" Margin="18,24,0,0" VerticalAlignment="Top">
                    <Button Content="选择目录" Click="Browse_Click" Style="{StaticResource GhostButtonStyle}" />
                    <Button Content="加载示例" Click="UseSample_Click" Style="{StaticResource GhostButtonStyle}" />
                  </WrapPanel>
                </Grid>
              </Border>

              <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="风险结果搜索" FontSize="13" Foreground="#6C7C86" />
                    <TextBox Margin="0,8,0,0" Text="{Binding FindingsSearchText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="组件搜索" FontSize="13" Foreground="#6C7C86" />
                    <TextBox Margin="0,8,0,0" Text="{Binding ComponentsSearchText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="风险发现" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
                  <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding FindingsView}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="风险等级" Binding="{Binding SeverityText}" Width="95" />
                      <DataGridTextColumn Header="依赖名称" Binding="{Binding DependencyName}" Width="150" />
                      <DataGridTextColumn Header="风险类型" Binding="{Binding CategoryText}" Width="110" />
                      <DataGridTextColumn Header="风险说明" Binding="{Binding Message}" Width="3*" />
                      <DataGridTextColumn Header="处理建议" Binding="{Binding Recommendation}" Width="3*" />
                      <DataGridTextColumn Header="来源文件" Binding="{Binding SourceFiles}" Width="180" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>

              <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="已发现组件" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
                  <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding ComponentsView}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="风险等级" Binding="{Binding SeverityText}" Width="95" />
                      <DataGridTextColumn Header="组件名称" Binding="{Binding Name}" Width="170" />
                      <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="130" />
                      <DataGridTextColumn Header="生态" Binding="{Binding Ecosystem}" Width="85" />
                      <DataGridTextColumn Header="依赖类型" Binding="{Binding DependencyTypeText}" Width="88" />
                      <DataGridTextColumn Header="来源" Binding="{Binding SourceTypeText}" Width="100" />
                      <DataGridTextColumn Header="风险分" Binding="{Binding RiskScore, StringFormat=F0}" Width="70" />
                      <DataGridTextColumn Header="证据文件" Binding="{Binding EvidenceFilesDisplay}" Width="2*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="SBOM 与风险">
            <Grid Margin="0,14,16,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <Border Style="{StaticResource CardStyle}" Width="200" Margin="0,0,16,16">
                  <StackPanel>
                    <TextBlock Text="综合风险分" FontSize="13" Foreground="#6C7C86" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding OverallScore}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="200" Margin="0,0,16,16">
                  <StackPanel>
                    <TextBlock Text="整体等级" FontSize="13" Foreground="#6C7C86" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding OverallSeverity}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource SlateBrush}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,16,16">
                  <StackPanel>
                    <TextBlock Text="SBOM 格式" FontSize="13" Foreground="#6C7C86" />
                    <TextBlock Margin="0,8,0,0" Text="v1.5 JSON" FontSize="30" FontWeight="Bold" Foreground="#7A5A3B" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="SBOM 组件数" FontSize="13" Foreground="#6C7C86" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding TotalDependencies}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource SlateBrush}" />
                  </StackPanel>
                </Border>
              </WrapPanel>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.15*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="SBOM 组件清单" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
                    <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding ComponentsView}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="组件名称" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="130" />
                        <DataGridTextColumn Header="PURL" Binding="{Binding PackageUrl}" Width="2*" />
                        <DataGridTextColumn Header="范围" Binding="{Binding DependencyTypeText}" Width="85" />
                        <DataGridTextColumn Header="等级" Binding="{Binding SeverityText}" Width="90" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="SBOM 预览" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
                    <TextBox Grid.Row="1" Margin="0,14,0,0" Text="{Binding SbomPreview}" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </TabItem>

          <TabItem Header="安全闸门与插件">
            <Grid Margin="0,14,16,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="安全闸门策略" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
                    <TextBlock Margin="0,8,0,0" Text="阻断阈值" FontSize="13" Foreground="#6C7C86" />
                    <Slider Margin="0,8,0,0" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding BlockThreshold, Mode=TwoWay}" />
                    <TextBlock Text="{Binding BlockThreshold}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <CheckBox Content="发现恶意依赖信号时直接阻断" IsChecked="{Binding BlockOnMalicious, Mode=TwoWay}" />
                    <CheckBox Content="插件规则识别到许可证风险时阻断" IsChecked="{Binding BlockOnLicenseRisk, Mode=TwoWay}" />
                    <CheckBox Content="依赖来自非仓库源时仅告警" IsChecked="{Binding WarnOnUnknownSource, Mode=TwoWay}" />
                    <WrapPanel Margin="0,14,0,0">
                      <Button Content="重新加载插件" Click="ReloadPlugins_Click" Style="{StaticResource GhostButtonStyle}" />
                      <Button Content="打开插件目录" Click="OpenPluginFolder_Click" Style="{StaticResource GhostButtonStyle}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.95*" />
                  <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="闸门结论" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="{Binding GateOutcomeText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                      <TextBlock Text="{Binding GateReasonText}" TextWrapping="Wrap" FontSize="13" Foreground="#415867" />
                      <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding GateTriggers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#F6EFE7" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource SlateBrush}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="插件规则" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
                    <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Plugins}">
                      <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay}" Width="80" />
                        <DataGridTextColumn Header="插件名称" Binding="{Binding DisplayName}" Width="180" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="90" />
                        <DataGridTextColumn Header="规则数" Binding="{Binding RuleCount}" Width="70" />
                        <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="3*" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>

        <StackPanel Grid.Column="1" Margin="16,14,0,0">
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="项目概览" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Margin="0,12,0,0" Text="{Binding SelectedProjectName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Margin="0,8,0,0" Text="{Binding LastScanAt}" FontSize="13" Foreground="#6C7C86" />
              <TextBlock Margin="0,8,0,0" Text="{Binding TargetPath}" FontSize="12" Foreground="#6C7C86" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="风险指标" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Grid.Row="1" Margin="0,14,0,0" Text="{Binding TotalDependencies, StringFormat=依赖总数：{0}}" FontSize="15" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding DirectDependencies, StringFormat=直接依赖：{0}}" FontSize="15" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding TransitiveDependencies, StringFormat=传递依赖：{0}}" FontSize="15" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="{Binding TotalFindings, StringFormat=风险发现：{0}}" FontSize="15" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="{Binding CriticalHighSummary}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
            </Grid>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="重点风险" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
              <ItemsControl Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding TopFindings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#F7F1EA" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock Text="{Binding DependencyName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SlateBrush}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#516874" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding SeverityText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="已启用插件" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SlateBrush}" />
              <TextBlock Margin="0,12,0,0" Text="{Binding EnabledPluginCount, StringFormat={}{0} 个规则包已启用}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>




